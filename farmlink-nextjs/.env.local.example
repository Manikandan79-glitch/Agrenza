# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ---- PHP backend (backend/api) ----
NEXT_PUBLIC_API_URL=http://localhost/farmlink/farmlink-php-api/backend/api

# ---- Firebase (Firebase Console -> Project settings -> General -> Your apps -> Web app) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Notes:
# - Phone Authentication (real SMS OTP) requires the Blaze (pay-as-you-go)
#   plan on your Firebase project, and the Phone provider enabled under
#   Authentication -> Sign-in method. You also need to add your dev/prod
#   domains under Authentication -> Settings -> Authorized domains.
# - Email link sign-in requires the Email/Password provider enabled with
#   "Email link (passwordless sign-in)" turned on.
